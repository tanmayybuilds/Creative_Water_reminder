{
  "appId": "com.pulseaistudio.lockin",
  "productName": "Water Reminder (Meme Edition)",
  "copyright": "Copyright © 2026 tanmay_chaudhary",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "electron/**/*",
    "public/icon.ico",
    "public/icon.png",
    "package.json"
  ],
  "extraResources": [
    {
      "from": "public/icon.ico",
      "to": "icon.ico"
    },
    {
      "from": "public/icon.png",
      "to": "icon.png"
    }
  ],
  "win": {
    "target": [
      {
        "target": "appx",
        "arch": ["x64"]
      }
    ],
    "icon": "build/icon.ico"
  },
  "appx": {
    "applicationId": "WaterReminderMemeEdition",
    "identityName": "com.pulseaistudio.lockin",
    "publisher": "CN=tanmay_chaudhary",
    "publisherDisplayName": "tanmay_chaudhary",
    "displayName": "Water Reminder (Meme Edition)",
    "backgroundColor": "#08080a",
    "showNameOnTiles": true,
    "setBuildNumber": true
  }
}
